
#include <stdio.h>
#include <string.h>

int main() {
    int vet[12], cont[12] = {0};
    int pares[12], qtdPares = 0;
    char nomes[144][50], auxNome[50];
    float precos[144], auxPreco;
    int qtdProdutos = 0;

    for (int i = 0; i < 12; i++) {
        printf("Digite um numero: ");
        scanf("%d", &vet[i]);
    }

    for (int i = 0; i < 12; i++) {
        for (int j = 0; j < 12; j++) {
            if (vet[i] == vet[j]) {
                cont[i]++;
            }
        }
    }

    for (int i = 0; i < 12; i++) {
        int repetido = 0;

        for (int j = 0; j < i; j++) {
            if (vet[i] == vet[j]) {
                repetido = 1;
            }
        }

        if (repetido == 0) {
            printf("\nNumero %d aparece %d vezes.\n", vet[i], cont[i]);

            if (cont[i] % 2 == 0) {
                pares[qtdPares] = vet[i];
                qtdPares++;
            } else {
                printf("Cadastre %d produtos:\n", vet[i]);

                for (int j = 0; j < vet[i] && qtdProdutos < 144; j++) {
                    printf("Nome do produto: ");
                    scanf(" %49[^\n]", nomes[qtdProdutos]);

                    printf("Preco: ");
                    scanf("%f", &precos[qtdProdutos]);

                    qtdProdutos++;
                }
            }
        }
    }

    for (int i = 0; i < qtdProdutos - 1; i++) {
        for (int j = i + 1; j < qtdProdutos; j++) {
            if (strcmp(nomes[i], nomes[j]) > 0) {
                strcpy(auxNome, nomes[i]);
                strcpy(nomes[i], nomes[j]);
                strcpy(nomes[j], auxNome);

                auxPreco = precos[i];
                precos[i] = precos[j];
                precos[j] = auxPreco;
            }
        }
    }

    for (int i = 0; i < qtdPares - 1; i++) {
        for (int j = i + 1; j < qtdPares; j++) {
            if (pares[i] < pares[j]) {
                int aux = pares[i];
                pares[i] = pares[j];
                pares[j] = aux;
            }
        }
    }

    printf("\nNumeros digitados:\n");
    for (int i = 0; i < 12; i++) {
        printf("%d ", vet[i]);
    }

    printf("\n\nProdutos em ordem alfabetica:\n");
    for (int i = 0; i < qtdProdutos; i++) {
        printf("%s - R$ %.2f\n", nomes[i], precos[i]);
    }

    printf("\nNumeros com ocorrencia par:\n");
    for (int i = 0; i < qtdPares; i++) {
        printf("%d ", pares[i]);
    }

    printf("\n");

    return 0;
}

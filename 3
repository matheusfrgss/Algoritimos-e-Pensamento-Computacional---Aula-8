
#include <stdio.h>
#include <string.h>

int main() {
    int vet[15], cont[15] = {0};
    int i, j, repetido, primo, soma;
    char animais[6][50];
    char novos[200][50];
    int qtdNovos = 0;

    for (i = 0; i < 6; i++) {
        printf("Digite o nome do animal %d: ", i + 1);
        scanf(" %49[^\n]", animais[i]);
    }

    for (i = 0; i < 15; i++) {
        printf("Digite um numero: ");
        scanf("%d", &vet[i]);
    }

    for (i = 0; i < 15; i++) {
        for (j = 0; j < 15; j++) {
            if (vet[i] == vet[j]) {
                cont[i]++;
            }
        }
    }

    for (i = 0; i < 15; i++) {
        repetido = 0;

        for (j = 0; j < i; j++) {
            if (vet[i] == vet[j]) {
                repetido = 1;
            }
        }

        if (repetido == 0 && cont[i] > 1) {
            printf("\nNumero %d aparece %d vezes.\n", vet[i], cont[i]);

            primo = 1;

            if (vet[i] < 2) {
                primo = 0;
            }

            for (j = 2; j < vet[i]; j++) {
                if (vet[i] % j == 0) {
                    primo = 0;
                }
            }

            if (primo == 1 && cont[i] % 2 != 0) {
                soma = vet[i] * cont[i];

                printf("Cadastre %d animais:\n", soma);

                for (j = 0; j < soma && qtdNovos < 200; j++) {
                    printf("Nome do animal: ");
                    scanf(" %49[^\n]", novos[qtdNovos]);
                    qtdNovos++;
                }
            }

            if (cont[i] % 2 == 0) {
                if (vet[i] >= 1 && vet[i] <= 6) {
                    printf("Animal correspondente: %s\n", animais[vet[i] - 1]);
                } else {
                    printf("Nao existe correspondencia.\n");
                }
            }
        }
    }

    printf("\nAnimais cadastrados pela soma:\n");

    for (i = 0; i < qtdNovos; i++) {
        printf("%s\n", novos[i]);
    }

    return 0;
}

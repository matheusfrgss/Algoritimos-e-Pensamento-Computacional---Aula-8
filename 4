
#include <stdio.h>
#include <string.h>

long long fibonacci(int n) {
    long long a = 0, b = 1, soma = 0, aux;

    for (int i = 0; i < n; i++) {
        soma = soma + a;
        aux = a + b;
        a = b;
        b = aux;
    }

    return soma;
}

int primo(long long n) {
    if (n < 2) {
        return 0;
    }

    for (int i = 2; i < n; i++) {
        if (n % i == 0) {
            return 0;
        }
    }

    return 1;
}

int main() {
